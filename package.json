{
  "name": "multitenant-saas-backend",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS backend with authentication and OTP verification",
  "main": "server.js",
  "scripts": {
    "start": "node init && node server.js",
    "dev": "node init && nodemon server.js",
    "build": "node init && prisma generate",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "saas",
    "multitenant",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^4.10.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "fuse.js": "^7.4.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.8.0",
    "pdfkit": "^0.18.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "prisma": "^4.10.0"
  }
}
