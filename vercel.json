{
  "version": 2,
  "installCommand": "npm install && npx prisma generate",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }],
  "env": { "NODE_ENV": "production" },
  "functions": {
    "api/index.js": {
      "includeFiles": "controllers/**"
    }
  }
}